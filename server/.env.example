# Stripe API keys (Dashboard -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret (Dashboard -> Developers -> Webhooks -> your endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...

# Base URL of the existing PurpleBox public booking API, no trailing slash
# e.g. https://api.purplebox.ae/api/public/bookings
BOOKING_API_BASE=

# Where the browser should land after Stripe Checkout
CHECKOUT_SUCCESS_URL=https://purplebox.ae/reserve-step-3.html?payment=success&session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=https://purplebox.ae/reserve-step-3.html?payment=cancelled

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=https://purplebox.ae,http://127.0.0.1:5500

PORT=4242
